{
  "name": "howl",
  "version": "0.0.0",
  "private": true,
  "description": "\u5728\u6d4f\u89c8\u5668\u91cc\u4e0e AI \u5bf9\u6218\u7684\u8eab\u4efd\u63a8\u7406\u6e38\u620f",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && vite build --config vite.server.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "selfplay": "tsx scripts/selfplay.ts",
    "test:perf": "pnpm build && playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "openai": "7.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
