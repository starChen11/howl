# 复制成 `.env` 后填入自己的 key（`.env` 已在 .gitignore 里）。
# 启动时用：`node --env-file=.env dist/server/index.js` 或 `DEEPSEEK_API_KEY=... pnpm dev`
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：换模型 / 调超时
# LLM_MODEL=deepseek-flash（默认）或 deepseek-v4-pro
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=1

# 各阶段最长等待时间（毫秒）。默认值是原来的两倍。
# HOWL_WOLF_CHAT_MS=100000
# HOWL_WOLF_VOTE_MS=20000
# HOWL_SEER_MS=120000
# HOWL_WITCH_MS=120000
# HOWL_HUNTER_SHOOT_MS=120000
# HOWL_DAY_SPEECH_MS=120000
# HOWL_PK_SPEECH_MS=120000
# HOWL_DAY_VOTE_MS=120000
# HOWL_DAY_VOTE_RUNOFF_MS=120000

# 用脚本 AI 代替真实模型（不花钱，适合先看界面）
# HOWL_FAKE_AI=1
